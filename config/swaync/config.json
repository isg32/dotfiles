{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "control-center-margin-top": 10,
    "control-center-margin-right": 10,
    "control-center-margin-bottom": 10,
    "control-center-width": 400,
    "control-center-height": 950,
    "notification-window-width": 400,
    "timeout": 6,
    "timeout-low": 4,
    "timeout-critical": 0,
    "notification-icon-size": 48,
    "notification-body-image-height": 120,
    "notification-body-image-width": 220,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,

    "widgets": [
        "title",
        "dnd",
        "volume",
        "backlight",
        "buttons-grid",
        "notifications"
    ],

    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "volume": {
            "label": "󰕾"
        },
        "backlight": {
            "label": "󰃟"
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "󰤨  Wi-Fi",
                    "command": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi"
                },
                {
                    "label": "󰂯  Bluetooth",
                    "command": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center bluetooth"
                },
                {
                    "label": "󰕾  Sound",
                    "command": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center sound"
                },
                {
                    "label": "󰁹  Power",
                    "command": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center power"
                },
                {
                    "label": "󰍹  Displays",
                    "command": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center display"
                },
                {
                    "label": "󰸉  Wallpaper",
                    "command": "~/.config/hypr/scripts/wallpaper-picker.sh"
                },
                {
                    "label": "󰌾  Lock",
                    "command": "hyprlock"
                },
                {
                    "label": "󰐥  Power",
                    "command": "~/.config/hypr/scripts/power-menu.sh"
                }
            ]
        }
    }
}
